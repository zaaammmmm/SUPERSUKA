# Portal origin (local or production)
APP_BASE_URL=http://localhost:3000

# Auth0 Regular Web Application
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=replace-with-a-random-secret-at-least-32-characters

# Service upstream (sesuaikan dengan URL deployment masing-masing layanan)
SISKA_ORIGIN=https://siska-theta.vercel.app
CAMPUSFIX_ORIGIN=https://campusfix.vercel.app
CAMPUSFIX_BASE_PATH=/campusfix
SUKAKETEMU_ORIGIN=https://sukeketemu.vercel.app
SUKAKETEMU_BASE_PATH=/sukeketemu
# Dua layanan ini opsional; gateway tidak mengaktifkannya sebelum origin diisi.
ARCHIVE_ORIGIN=
ARCHIVE_BASE_PATH=/
PAAS_ORIGIN=
PAAS_BASE_PATH=/

# SUPERAPP_SKIN=off menonaktifkan transformasi visual global, proxy tetap aktif.
# SUPERAPP_BLUE_AS_BRAND=1 memetakan keluarga warna biru menjadi warna brand,
# bukan warna status informasi/proses.
